# ============================================================
# Musicals — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Supabase (Required)
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api
# ----------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ----------------------------------------------------------
# AWS S3 — File Storage (audio files + thumbnails)
# Get these from: AWS Console → IAM → Users → Access Keys
# ----------------------------------------------------------
VITE_AWS_ACCESS_KEY_ID=your-iam-access-key-id
VITE_AWS_SECRET_ACCESS_KEY=your-iam-secret-access-key
VITE_AWS_REGION=ap-south-1
VITE_AWS_S3_BUCKET=musicals-media
